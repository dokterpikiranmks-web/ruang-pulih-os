# ==============================================================================
# RUANG PULIH OS — ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini ke .env.local untuk pengembangan lokal
# JANGAN PERNAH commit file .env atau membocorkan Service Role Key ke client.
# ==============================================================================

# 1. SUPABASE (Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. GOOGLE GEMINI API (Multi-Agent Clinical Consensus Engine)
# Wajib gunakan Paid Pay-as-you-go Key demi privasi data kesehatan pasien
GEMINI_API_KEY=your-google-gemini-api-key

# 3. WHATSAPP GATEWAY (Fonnte REST API)
FONNTE_TOKEN=your-fonnte-device-token

# 4. SCHEDULER & SECURITY
# Token rahasia otorisasi pemanggilan endpoint cron /api/cron/process-wa-queue
CRON_SECRET=your-random-cron-secret-32-chars
# Secret key untuk menandatangani HMAC cookie sesi pasien PWA
PATIENT_SESSION_SECRET=your-random-patient-session-secret-32-chars

# 5. TRACKING, REVIEW & REPUTATION
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
NEXT_PUBLIC_APP_URL=https://ruangpulihmakassar.com
NEXT_PUBLIC_GOOGLE_MAPS_REVIEW_URL=https://maps.app.goo.gl/your-gmaps-link
NEXT_PUBLIC_GMAPS_REVIEW_URL=https://maps.app.goo.gl/your-gmaps-link

# 6. ADMIN AUTHENTICATION
# Daftar email praktisi/admin yang diizinkan login (pisahkan koma jika lebih dari satu)
ADMIN_EMAILS=admin@ruangpulihmakassar.com,dokterpikiran@gmail.com

# 7. OPSIONAL: KURS KONVERSI MATA UANG
USD_TO_IDR_RATE=16500
